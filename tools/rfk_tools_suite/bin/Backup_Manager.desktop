[Desktop Entry]
Name=RFK Backup & Recovery
Comment=RF-KIT Automated & Manual SD Duplicator
Exec=sh -c 'B=$(command -v chromium || command -v chromium-browser || echo chromium); exec "$B" --app=http://localhost:8088/backup'
Icon=drive-removable-media
Terminal=false
Type=Application
Categories=Utility;HamRadio;
